{
  "name": "jane",
  "version": "0.1.0",
  "description": "A terminal coding agent for local AI models",
  "license": "MIT",
  "type": "module",
  "bin": {
    "jane": "bin/jane.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
